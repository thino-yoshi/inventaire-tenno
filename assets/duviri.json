s/Types/Items/MiscItems/IncarnonAdapters/Melee/ObexIncarnonUnlocker","fr":"Obex","en":"Obex","c":"melee","i":"https://cdn.warframestat.us/img/ObexIncarnonAdapter.png"},{"id":"/Lotus/Types/Items/MiscItems/IncarnonAdapters/Melee/OkinaIncarnonUnlocker","fr":"Okina","en":"Okina","c":"melee","i":"https://cdn.warframestat.us/img/OkinaIncarnonAdapter.png"},{"id":"/Lotus/Types/Items/MiscItems/IncarnonAdapters/Melee/SibearIncarnonUnlocker","fr":"Sibear","en":"Sibear","c":"melee","i":"https://cdn.warframestat.us/img/SibearIncarnonAdapter.png"},{"id":"/Lotus/Types/Items/MiscItems/IncarnonAdapters/Melee/SkanaIncarnonUnlocker","fr":"Skana","en":"Skana","c":"melee","i":"https://cdn.warframestat.us/img/SkanaIncarnonAdapter.png"}],"res":[{"id":"/Lotus/Types/Gameplay/Duviri/Resource/DuviriRockItem","fr":"Aggripierre","en":"Aggristone","i":"https://cdn.warframestat.us/img/DuviriAggristone.png","dfr":"On dit que les Formations d'Aggri sont de la salive durcie des puissants Orowyrms. Les citoyens de Duviri pensent que les Aggripierres sont de puissants talismans. Lieu: Duviri","den":"It is said that Aggri Formations are hardened saliva from mighty Orowyrms. Duviri citizens believe Aggristones are powerful talismans. Location: Duviri"},{"id":"/Lotus/Types/Gameplay/Duviri/Resource/DuviriPlantItemD","fr":"Arbuste Yao","en":"Yao Shrub","i":"https://cdn.warframestat.us/img/DuviriPlantExtractD.png","dfr":"La lumière chaude de l'Arbuste Yao brille même dans les endroits sombres et froids. Lieu: Duviri","den":"The warm light of the Yao Shrub glows even within cold dark places. Location: Duviri"},{"id":"/Lotus/Types/Gameplay/Duviri/Resource/DuviriPlantItemF","fr":"Dracoracine","en":"Dracroot","i":"https://cdn.warframestat.us/img/DuviriPlantExtractF.png","dfr":"La Dracoracine est un aliment de base du régime alimentaire du Wyrmling. Lieu: Duviri","den":"Dracroot is a staple of the Wyrmling’s diet. Location: Duviri"},{"id":"/Lotus/Types/Gameplay/Duviri/Resource/DuviriPlantItemB","fr":"Eevani","en":"Eevani","i":"https://cdn.warframestat.us/img/DuviriPlantExtractB.png","dfr":"Les citoyens de Duviri sont connus pour écraser les feuilles d'Eevani en une pâte qui atténue l'inconfort causé par les blessures. Lieu: Duviri","den":"Duviri citizens have been known to mash Eevani leaves into a paste that alleviates the discomfort caused by fresh wounds. Location: Duviri"},{"id":"/Lotus/Types/Gameplay/Duviri/Resource/DuviriMushroomItem","fr":"Extrait de Tasoma","en":"Tasoma Extract","i":"https://cdn.warframestat.us/img/DuviriPlantExtractMushroom.png","dfr":"Les citoyens de Duviri en proie à des cauchemars recherchent du Tasoma, car ses tiges peuvent être écrasées pour créer un jus qui génère des rêves agréables. Malheureusement, il est difficile de se procurer du Tasoma car il ne pousse que dans les grottes. Lieu: Duviri","den":"Duviri citizens plagued by nightmares seek Tasoma, because its stalks can be crushed to create juice that invites pleasant dreams. Unfortunately, it is difficult to forage Tasoma as it only grows in caves. Location: Duviri"},{"id":"/Lotus/Types/Gameplay/Duviri/Resource/DuviriKullervoDropItem","fr":"Fléau de Kullervo","en":"Kullervo's Bane","i":"https://cdn.warframestat.us/img/DuviriKullervoDropItem.png","dfr":"La fureur de Kullervo incarnée. Acrithis échangera cet artefact précieux contre certains objets de sa collection.  Lieu: Affronter Kullervo et vaincre l'Orowyrm dans la même mission de Duviri pendant une Spirale de Peur, de Colère ou de Chagrin","den":"Kullervo's fury incarnate. Acrithis will trade this prized artifact for certain items from her collection. Location: Earned by confronting Kullervo and defeating the Orowyrm in the same Duviri mission during the Fear, Anger, or Sorrow spiral"},{"id":"/Lotus/Types/Gameplay/Duviri/Resource/DuviriPlantItemA","fr":"Kovnik","en":"Kovnik","i":"https://cdn.warframestat.us/img/DuviriPlantExtractA.png","dfr":"Les citoyens de Duviri récoltent les feuilles de Kovnik pour créer des thés revigorants. Lieu: Duviri","den":"Duviri citizens harvest Kovnik leaves to blend invigorating teas. Location: Duviri"},{"id":"/Lotus/Types/Gameplay/Duviri/Resource/DuviriEnemyDropItem","fr":"Lamentus","en":"Lamentus","i":"https://cdn.warframestat.us/img/DuviriAnima.png","dfr":"Un murmure de celui qui est tombé. Lieu: Duviri","den":"A whisper of the fallen. Location: Duviri"},{"id":"/Lotus/Types/Gameplay/Duviri/Resource/DuviriProcessedItem","fr":"Perle Saggen","en":"Saggen Pearl","i":"https://cdn.warframestat.us/img/DuviriPearl.png","dfr":"Les guerriers Thrax utilisent le liquide lourd tiré des Puits de Saggen pour polir leurs armes. Lieu: Duviri","den":"Thrax warriors use the heavy liquid drawn from Saggen Wells to polish their weapons. Location: Duviri"},{"id":"/Lotus/Types/Gameplay/Duviri/Resource/DuviriDragonDropItem","fr":"Pince de Pathos","en":"Pathos Clamp","i":"https://cdn.warframestat.us/img/DuviriWyrmsoul.png","dfr":"La manifestation de la malveillance de Thrax qui façonne les interventions des Orowyrms. Lieu: Vaincre l'Orowyrm à Duviri","den":"The manifestation of Thrax's malevolence that shapes the Orowyrms' outbursts. Location: Rewarded upon defeating the Orowyrm in Duviri"},{"id":"/Lotus/Types/Gameplay/Duviri/Resource/DuviriPlantItemC","fr":"Pousse de Connla","en":"Connla Sprout","i":"https://cdn.warframestat.us/img/DuviriPlantExtractC.png","dfr":"Le jus des Pousses de Connla a un goût sucré et rafraîchissant. Lieu: Duviri","den":"The water that courses through Connla Sprouts tastes sweet and refreshing. Location: Duviri"},{"id":"/Lotus/Types/Gameplay/Duviri/Resource/DuviriFractalItem","fr":"Rune de Moelle","en":"Rune Marrow","i":"https://cdn.warframestat.us/img/DuviriRunicMarrow.png","dfr":"La Rune de Moelle jaillit du noyau de Duviri. Lieu: L'Hypogée, à Duviri","den":"Rune Marrow erupts from Duviri’s core. Location: The Undercroft in Duviri"},{"id":"/Lotus/Types/Gameplay/Duviri/Resource/DuviriPlantItemE","fr":"Silphsela","en":"Silphsela","i":"https://cdn.warframestat.us/img/DuviriPlantExtractE.png","dfr":"Il est traditionnellement admis que voir de la Silphsela flotter dans les airs annonce un changement imminent dans le ciel. Lieu: Duviri","den":"It is traditionally held that to see Silphsela floating in the air heralds an imminent change in the sky. Location: Duviri"},{"id":"/Lotus/Types/Gameplay/Duviri/Resource/DuviriMushroomSeed","fr":"Spore de Tasoma","en":"Tasoma Spore","i":"https://cdn.warframestat.us/img/ComponentRubedo.png","dfr":"Une spore de champignon Tasoma, adaptée à la culture dans le jardin de la Dormizone.","den":"A Tasoma fungal spore, suitable for growing in the Dormizone’s garden."},{"id":"/Lotus/Types/Gameplay/Duviri/Resource/DuviriEndlessItem","fr":"Tertium","en":"Tertium","i":"https://cdn.warframestat.us/img/ComponentGallium.png","dfr":"Sa puissance réside dans son potentiel. Lieu: Duviri","den":"Its power lies in its potential. Location: Duviri"},{"id":"/Lotus/Types/Gameplay/Duviri/Resource/DuviriPlantItemG","fr":"Ueymag","en":"Ueymag","i":"https://cdn.warframestat.us/img/DuviriPlantExtractG.png","dfr":"On dit que la chair d'Ueymag est délicieuse. Faites juste attention aux piques. Lieu: Duviri","den":"Ueymag meat is said to be delicious. Just mind the barbs. Location: Duviri"},{"id":"/Lotus/Types/Gameplay/Duviri/Resource/DuviriPuzzleItem","fr":"Énigme Gyrum","en":"Enigma Gyrum","i":"https://cdn.warframestat.us/img/DuviriKey.png","dfr":"Un jeton célébrant la résolution d'une Énigme de Duviri. Lieu: Obtenu en complétant les énigmes de l'Expérience Duviri","den":"A token celebrating the successful solution of a Duviri Enigma. Location: Earned by completing Enigmas in The Duviri Experience"}]}